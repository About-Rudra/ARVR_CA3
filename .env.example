# Copy to Backend/.env (never commit .env). NEVER commit real secrets.
# See docs/DEPLOYMENT.md for where each var is used.
# URL convention: Unity + backend use the backend ORIGIN (no /api suffix);
# ApiClient appends /api/... itself. Health: GET {origin}/health.

# --- Backend (Express, Backend/server.js; PORT defaults to 3000) ---
PORT=3000
# Postgres connection string. Empty = in-memory seed store (demo/tests).
# Supabase example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=
# Comma-separated origins allowed to call the API (native Unity builds don't
# need CORS, but dashboard WebGL smoke-tests / browser tools do).
CORS_ORIGIN=http://localhost:3000

# --- Unity client (DEV2 ApiConfig chain; DEV4 AppBootstrapper agrees) ---
# Resolution order: --api-url CLI arg > AR_API_BASE_URL env > PlayerPrefs
# "AR_API_BASE_URL" > Resources/api_config.json > inspector/ScriptableObject.
# Canonical key shared by AppBootstrapper + ApiConfig (case-sensitive).
API_BASE_URL=http://localhost:3000
# Alias kept for backwards-compat with early drafts. Prefer API_BASE_URL.
AR_API_BASE_URL=http://localhost:3000

# --- Postgres on Supabase / Neon (free tier, see docs/DEPLOYMENT.md) ---
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_KEY=your-anon-or-service-key
# (Neon alternative: DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/db)
