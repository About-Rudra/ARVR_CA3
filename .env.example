# Copy to Backend/.env (never commit .env). NEVER commit real secrets.
# See docs/DEPLOYMENT.md for where each var is used.
# URL convention: backend + web frontends use the backend ORIGIN (no /api
# suffix); clients append /api/... themselves. Health: GET {origin}/health.

# --- Backend (Express, Backend/server.js; PORT defaults to 3000) ---
PORT=3000
# Postgres connection string. Empty = in-memory seed store (demo/tests).
# Supabase example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Neon example: postgresql://user:<password>@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=
# Optional: DB connect timeout (ms) before requests fail with 503 DB_UNAVAILABLE.
# DB_CONNECT_TIMEOUT_MS=10000
# Optional: SSL is auto-off for localhost / sslmode=disable, on for hosted DBs.
# PGSSL=false
# Comma-separated browser origins allowed to call the API.
# Leave EMPTY for local dev (allows all: Unity editor, LAN devices, and the
# static frontends on any local port, e.g. http://localhost:8000).
# In production, restrict to the deployed frontend origin(s), e.g.:
# CORS_ORIGIN=https://<dashboard>.vercel.app,https://<ar>.vercel.app
CORS_ORIGIN=

# --- Web frontends (DEV1 frontend/ar, DEV3 frontend/dashboard) ---
# Resolution order in both apps (no prod URL is hardcoded in the code):
#   1. window.__API_BASE_URL (inline override set by the host page/deploy)
#   2. localStorage "AR_API_BASE_URL" (in-page API URL field, or ?api= on the AR page)
#   3. http://localhost:3000 (local dev default only)
# For a deployed frontend, set API_BASE_URL in the Netlify site settings:
# the build runs scripts/write-frontend-env.js, which writes env.js
# (window.__API_BASE_URL) - or type the origin into the page's API URL field.
# The two vars below are the same backend origin for server-side/CI use:
# Backend origin (no /api suffix). Local dev default; prod = deployed backend origin.
API_BASE_URL=http://localhost:3000
# Alias kept for backwards-compat with early drafts (Unity PlayerPrefs key
# "AR_API_BASE_URL" and localStorage key share this name). Prefer API_BASE_URL.
AR_API_BASE_URL=http://localhost:3000

# --- Postgres on Supabase / Neon (free tier, see docs/DEPLOYMENT.md) ---
# Only needed when using Supabase client libs directly; the backend itself
# needs just DATABASE_URL above.
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_KEY=your-anon-or-service-key
