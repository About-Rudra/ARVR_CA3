# Copy to .env (never commit .env). Supabase-compatible via DATABASE_URL.
PORT=3000
# Postgres connection string. Leave empty to run on the in-memory seed store (demo/tests).
# Supabase example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=
# Comma-separated origins allowed to call the API. Empty/unset = allow all
# (default, convenient for Unity editor + LAN-device testing). Restrict in production.
CORS_ORIGIN=
# Backend origin for Unity clients (ApiClient appends /api/... itself). Health: GET {origin}/health.
API_BASE_URL=http://localhost:3000
