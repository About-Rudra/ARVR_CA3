{
  "name": "ar-passport-backend",
  "version": "1.0.0",
  "description": "REST API for AR Digital Passport for Physical Assets (Unity -> Express -> Postgres)",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/api.test.js",
      "**/__tests__/**/*.js"
    ],
    "testTimeout": 15000
  }
}
